(function() {
  // Elements
  const loginForm = document.getElementById('clinical-login-form');
  const emailInput = document.getElementById('clinical-email');
  const passwordInput = document.getElementById('clinical-password');
  const emailError = document.getElementById('email-error-hint');
  const passwordError = document.getElementById('password-error-hint');
  const togglePassBtn = document.getElementById('toggle-password-visibility');
  const eyeIcon = document.getElementById('password-eye-icon');
  
  const statusContainer = document.getElementById('auth-status-container');
  const statusIcon = document.getElementById('auth-status-icon');
  const statusTitle = document.getElementById('auth-status-title');
  const statusDesc = document.getElementById('auth-status-desc');
  
  const submitBtn = document.getElementById('submit-auth-btn');
  const btnSpinner = document.getElementById('btn-spinner');
  const btnLock = document.getElementById('btn-lock-icon');
  const btnText = document.getElementById('btn-text');

  const autofillBtn = document.getElementById('quick-fill-btn');
  const instantDemoBtn = document.getElementById('instant-demo-access-btn');
  const webauthnBtn = document.getElementById('webauthn-btn');
  const googleBtn = document.getElementById('google-auth-btn');

  // Modal elements
  const modal = document.getElementById('demo-modal');
  const modalTitle = document.getElementById('modal-title');
  const modalIcon = document.getElementById('modal-icon');
  const modalBody = document.getElementById('modal-body');
  const modalClose = document.getElementById('modal-close-btn');
  const modalCancel = document.getElementById('modal-cancel-btn');
  const modalConfirm = document.getElementById('modal-confirm-btn');
  const recoveryLink = document.getElementById('toggle-recovery-view-link');
  const registrationBtn = document.getElementById('toggle-registration-btn');

  // Toggle Password Visibility
  if (togglePassBtn && passwordInput && eyeIcon) {
    togglePassBtn.addEventListener('click', () => {
      const isPass = passwordInput.getAttribute('type') === 'password';
      passwordInput.setAttribute('type', isPass ? 'text' : 'password');
      eyeIcon.textContent = isPass ? 'visibility_off' : 'visibility';
    });
  }

  // Quick fill preset
  if (autofillBtn) {
    autofillBtn.addEventListener('click', () => {
      emailInput.value = 'eleanor.vance@demo.health';
      passwordInput.value = 'VaultKey_99182!Eleanor';
      hideStatus();
      emailError.classList.add('hidden');
      passwordError.classList.add('hidden');
    });
  }

  function showStatus(type, title, desc) {
    statusContainer.classList.remove('hidden', 'bg-error-container', 'text-on-error-container', 'bg-tertiary-container', 'text-on-tertiary-container', 'bg-secondary-fixed', 'text-on-secondary-fixed');
    
    if (type === 'error') {
      statusContainer.classList.add('bg-error-container');
      statusIcon.textContent = 'error';
      statusIcon.className = 'material-symbols-outlined text-[20px] shrink-0 text-error';
      statusTitle.className = 'font-title-sm text-title-sm leading-snug text-error font-semibold';
      statusDesc.className = 'font-body-sm text-body-sm mt-0.5 text-on-error-container';
    } else if (type === 'success') {
      statusContainer.classList.add('bg-surface-container-high');
      statusIcon.textContent = 'check_circle';
      statusIcon.className = 'material-symbols-outlined text-[20px] shrink-0 text-on-tertiary-container';
      statusTitle.className = 'font-title-sm text-title-sm leading-snug text-primary font-semibold';
      statusDesc.className = 'font-body-sm text-body-sm mt-0.5 text-on-surface-variant';
    } else if (type === 'loading') {
      statusContainer.classList.add('bg-surface-container-low');
      statusIcon.textContent = 'sync';
      statusIcon.className = 'material-symbols-outlined text-[20px] shrink-0 text-secondary animate-spin';
      statusTitle.className = 'font-title-sm text-title-sm leading-snug text-primary font-semibold';
      statusDesc.className = 'font-body-sm text-body-sm mt-0.5 text-on-surface-variant';
    }

    statusTitle.textContent = title;
    statusDesc.textContent = desc;
  }

  function hideStatus() {
    statusContainer.classList.add('hidden');
  }

  function executeAuthenticationFlow(targetUser = 'Eleanor Vance') {
    hideStatus();
    emailError.classList.add('hidden');
    passwordError.classList.add('hidden');

    const email = emailInput.value.trim();
    const pass = passwordInput.value.trim();

    if (!email || !email.includes('@')) {
      emailError.classList.remove('hidden');
      showStatus('error', 'Authentication Failure', 'Please provide a valid clinical ID or email address.');
      return;
    }

    if (!pass) {
      passwordError.classList.remove('hidden');
      showStatus('error', 'Missing Credential', 'A clinical encryption passphrase is required to sign this enclave session.');
      return;
    }

    // Realistic Simulated Flow
    submitBtn.disabled = true;
    btnSpinner.classList.remove('hidden');
    btnLock.classList.add('hidden');
    btnText.textContent = 'Verifying WebAuthn / Clinical Credentials...';
    showStatus('loading', 'Cryptographic Verification', 'Negotiating SMART-on-FHIR token & SHA-256 state handshake...');

    setTimeout(() => {
      showStatus('success', 'Access Authorized', `Cryptographic Proof Accepted. Launching Patient Dashboard for ${targetUser}...`);
      btnText.textContent = 'Redirecting to Protected Records...';

      setTimeout(() => {
        // Evaluate Desktop vs Mobile screen routing token
        const isMobile = window.innerWidth < 768;
        const targetScreen = isMobile ? '{{DATA:SCREEN:SCREEN_24}}' : '{{DATA:SCREEN:SCREEN_26}}';
        
        // Navigation simulation
        window.location.hash = targetScreen;
      }, 900);
    }, 1200);
  }

  if (loginForm) {
    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();
      executeAuthenticationFlow('Eleanor Vance');
    });
  }

  if (instantDemoBtn) {
    instantDemoBtn.addEventListener('click', () => {
      emailInput.value = 'eleanor.vance@demo.health';
      passwordInput.value = 'VaultKey_99182!Eleanor';
      executeAuthenticationFlow('Eleanor Vance');
    });
  }

  if (webauthnBtn) {
    webauthnBtn.addEventListener('click', () => {
      showStatus('loading', 'Hardware Passkey Requested', 'Prompting platform biometric authenticator (TouchID / Windows Hello)...');
      setTimeout(() => {
        executeAuthenticationFlow('Eleanor Vance (Biometric)');
      }, 600);
    });
  }

  if (googleBtn) {
    googleBtn.addEventListener('click', () => {
      showStatus('loading', 'Federated IdP Redirect', 'Contacting Google OpenID Connect Provider...');
      setTimeout(() => {
        executeAuthenticationFlow('eleanor.vance@gmail.com');
      }, 700);
    });
  }

  // Modal handlers
  function openModal(title, icon, contentHtml, onConfirm) {
    modalTitle.textContent = title;
    modalIcon.textContent = icon;
    modalBody.innerHTML = contentHtml;
    modal.classList.remove('hidden');

    const handleConfirm = () => {
      if (onConfirm) onConfirm();
      closeModal();
      modalConfirm.removeEventListener('click', handleConfirm);
    };

    modalConfirm.addEventListener('click', handleConfirm);
  }

  function closeModal() {
    modal.classList.add('hidden');
  }

  if (modalClose) modalClose.addEventListener('click', closeModal);
  if (modalCancel) modalCancel.addEventListener('click', closeModal);

  if (recoveryLink) {
    recoveryLink.addEventListener('click', (e) => {
      e.preventDefault();
      openModal(
        'Credential Recovery Gate',
        'key',
        `<p class="mb-2">Simulate a cryptographically signed recovery package dispatch to your medical provider on record.</p>
         <div class="p-2 rounded bg-surface-container text-xs font-mono">Recipient: eleanor.vance@demo.health<br/>Proof Standard: NIST SP 800-63B</div>`,
        () => {
          showStatus('success', 'Recovery Dispatch Simulated', 'A temporary zero-knowledge access challenge has been logged.');
        }
      );
    });
  }

  if (registrationBtn) {
    registrationBtn.addEventListener('click', (e) => {
      e.preventDefault();
      openModal(
        'Identity Assurance (IAL2/AAL2)',
        'person_add',
        `<p class="mb-2">Unified Health Wallet requires state registry validation or an authorized HL7 FHIR Master Patient Index (MPI) token.</p>
         <p class="text-xs text-on-surface-variant">Would you like to load the Eleanor Vance pre-verified clinical persona into this prototype?</p>`,
        () => {
          emailInput.value = 'eleanor.vance@demo.health';
          passwordInput.value = 'VaultKey_99182!Eleanor';
          showStatus('success', 'Demo Persona Activated', 'Eleanor Vance credentials loaded. Click "Authenticate" to proceed.');
        }
      );
    });
  }

})();
</script></main><footer class="w-full bg-surface-container-low py-space-lg mt-auto"><div class="max-w-7xl mx-auto px-margin-lg flex flex-col md:flex-row items-center justify-between gap-space-md"><div class="flex flex-col gap-1 text-center md:text-left"><div class="flex flex-wrap items-center justify-center md:justify-start gap-space-sm text-on-surface-variant"><span class="font-code-sm text-code-sm font-semibold uppercase tracking-wider text-primary">NIST SP 800-63-3 (AAL3/IAL2)</span><span class="text-outline-variant">•</span><span class="font-code-sm text-code-sm uppercase tracking-wider">45 CFR § 164.312 HIPAA Safeguards</span><span class="text-outline-variant">•</span><span class="font-code-sm text-code-sm uppercase tracking-wider">OAuth 2.0 / SMART on FHIR</span></div><p class="font-body-sm text-body-sm text-on-surface-variant">Protected Health Information is secured under federal civil &amp; cryptographic compliance mandates. Unauthorized access attempts are monitored and recorded.</p></div><div class="flex items-center gap-space-md"><a class="font-label-md text-label-md text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors px-space-sm py-1 rounded-lg" data-path="public-portal-redirect" href="#">Public Gateway</a><a class="font-label-md text-label-md text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors px-space-sm py-1 rounded-lg" data-path="security-protocols" href="#">Security Assurance</a></div></div></footer></body></html>