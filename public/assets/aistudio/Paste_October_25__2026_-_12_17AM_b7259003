<script>
    function togglePasswordVisibility(fieldId, triggerBtn) {
      const input = document.getElementById(fieldId);
      const icon = triggerBtn.querySelector('.material-symbols-outlined');
      if (input.type === 'password') {
        input.type = 'text';
        icon.textContent = 'visibility_off';
      } else {
        input.type = 'password';
        icon.textContent = 'visibility';
      }
    }

    function evaluatePasswordStrength(pass) {
      const lengthCheck = pass.length >= 12;
      const upperCheck = /[A-Z]/.test(pass);
      const numberCheck = /[0-9]/.test(pass);
      const symbolCheck = /[^A-Za-z0-9]/.test(pass);

      updateRule('rule-length', lengthCheck);
      updateRule('rule-upper', upperCheck);
      updateRule('rule-number', numberCheck);
      updateRule('rule-symbol', symbolCheck);

      const score = [lengthCheck, upperCheck, numberCheck, symbolCheck].filter(Boolean).length;
      
      const bars = [document.getElementById('bar-1'), document.getElementById('bar-2'), document.getElementById('bar-3'), document.getElementById('bar-4')];
      const strengthText = document.getElementById('strengthText');

      bars.forEach(b => b.className = 'h-1 rounded-full bg-surface-container-highest transition-colors');

      if (score === 0) {
        strengthText.textContent = 'Unacceptable (0/4)';
        strengthText.className = 'font-code-sm text-code-sm font-semibold uppercase text-error';
      } else if (score <= 2) {
        strengthText.textContent = 'Weak (' + score + '/4)';
        strengthText.className = 'font-code-sm text-code-sm font-semibold uppercase text-error';
        for (let i = 0; i < score; i++) bars[i].className = 'h-1 rounded-full bg-error transition-colors';
      } else if (score === 3) {
        strengthText.textContent = 'Good (3/4)';
        strengthText.className = 'font-code-sm text-code-sm font-semibold uppercase text-secondary';
        for (let i = 0; i < score; i++) bars[i].className = 'h-1 rounded-full bg-secondary-container transition-colors';
      } else if (score === 4) {
        strengthText.textContent = 'Vault Grade (4/4)';
        strengthText.className = 'font-code-sm text-code-sm font-semibold uppercase text-on-tertiary-container';
        for (let i = 0; i < score; i++) bars[i].className = 'h-1 rounded-full bg-on-tertiary-container transition-colors';
      }

      validateMatch();
    }

    function updateRule(elementId, passed) {
      const el = document.getElementById(elementId);
      const icon = el.querySelector('.material-symbols-outlined');
      if (passed) {
        el.className = 'flex items-center gap-1 text-on-tertiary-container font-semibold';
        icon.textContent = 'check_circle';
      } else {
        el.className = 'flex items-center gap-1 text-on-surface-variant';
        icon.textContent = 'cancel';
      }
    }

    function validateMatch() {
      const p1 = document.getElementById('masterPassword').value;
      const p2 = document.getElementById('confirmPassword').value;
      const feedback = document.getElementById('matchFeedback');
      
